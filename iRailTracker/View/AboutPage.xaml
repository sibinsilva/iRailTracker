<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="iRailTracker.View.AboutPage"
             Title="About">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12" MaximumWidthRequest="480">

            <!-- APP CARD -->
            <Border Style="{DynamicResource Card}" Padding="24">
                <VerticalStackLayout Spacing="10">
                    <Image Source="logo.png"
                           WidthRequest="96"
                           HeightRequest="96"
                           HorizontalOptions="Center"
                           SemanticProperties.Description="iRailTracker logo" />

                    <Label Text="iRailTracker"
                           FontSize="24"
                           FontFamily="OpenSansSemibold"
                           HorizontalTextAlignment="Center" />

                    <Border Style="{DynamicResource Chip}" HorizontalOptions="Center" Padding="12,4">
                        <Label x:Name="VersionLabel"
                               FontSize="12"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Border>

                    <Label Text="Track live Irish Rail train services, view real-time station data, and follow your journey on an interactive map."
                           FontSize="14"
                           Margin="0,6,0,0"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- DETAILS CARD -->
            <Border Style="{DynamicResource Card}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="DEVELOPER" Style="{StaticResource SectionLabel}" />
                        <Label Text="Sibin Silvester" FontSize="15" FontFamily="OpenSansSemibold" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="SOURCE CODE" Style="{StaticResource SectionLabel}" />
                        <Label Text="github.com/sibinsilva/iRailTracker"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               TextDecorations="Underline"
                               SemanticProperties.Hint="Opens the source code in your browser">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGitHubLinkTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="DATA" Style="{StaticResource SectionLabel}" />
                        <Label Text="Irish Rail Realtime API · Map © OpenStreetMap contributors"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
