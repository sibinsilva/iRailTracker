<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="iRailTracker.View.AppHome"
             xmlns:vm="clr-namespace:iRailTracker.ViewModel"
             xmlns:views="clr-namespace:iRailTracker.View"
             xmlns:converters="clr-namespace:iRailTracker.Converters"
             Title="iRailTracker">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <NavigationPage.TitleView>
        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
            <Image Source="logo.png"
                   HeightRequest="28"
                   WidthRequest="28"
                   VerticalOptions="Center" />
            <Label Text="iRailTracker"
                   FontSize="Title"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </NavigationPage.TitleView>

    <ContentPage.ToolbarItems>
        <!-- Font glyph instead of settings.png, which is white and vanished on the light toolbar -->
        <ToolbarItem
            Priority="0"
            Order="Primary"
            Text="Settings"
            Command="{Binding OpenSettingsCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="⚙"
                                 Size="22"
                                 Color="White" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem
            Text="About"
            Priority="1"
            Order="Secondary"
            Clicked="OnAboutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- HEADER -->
        <views:AppHomeHeader Grid.Row="0" />

        <!-- FAVOURITE STATION CHIPS -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    IsVisible="{Binding FavouriteStations.Count, Converter={StaticResource CountToBoolConverter}}">
            <HorizontalStackLayout Spacing="8"
                                   Padding="12,0,12,8"
                                   BindableLayout.ItemsSource="{Binding FavouriteStations}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Chip}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppHomeViewModel}}, Path=SelectFavouriteCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label FontSize="13" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="★ " />
                                        <Span Text="{Binding .}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- LIST -->
        <views:AppHomeListView x:Name="JourneysListView" Grid.Row="2" />

        <!-- FIRST-RUN HINT: nothing selected yet -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="40,32"
                             Spacing="10"
                             VerticalOptions="Start"
                             Opacity="0.9"
                             IsVisible="{Binding ShowStartHint}">
            <Label Text="🚆" FontSize="40" HorizontalOptions="Center" />
            <Label Text="Choose a station to see live departures"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="Pick one above or use your location. Add favourites in Settings to open them with one tap."
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
        </VerticalStackLayout>

        <!-- EMPTY / NO DATA OVERLAY -->
        <Grid Grid.Row="2"
              IsVisible="{Binding NoJourneyFound}"
              Padding="32,16">

            <Label Text="{Binding NoJourneyMsg}"
                   FontSize="16"
                   LineBreakMode="WordWrap"
                   HorizontalOptions="Fill"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </Grid>

    </Grid>
</ContentPage>
