<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="iRailTracker.View.AppHomeHeader"
             xmlns:vm="clr-namespace:iRailTracker.ViewModel"
             xmlns:strings="clr-namespace:iRailTracker.Resources.Strings">

    <Border
        StrokeShape="RoundRectangle 16"
        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
        Padding="16"
        Margin="12">

        <Border.Shadow>
            <Shadow Radius="12"
                    Opacity="0.25"
                    Offset="0,4" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="16">

            <!-- HEADER -->
            <Label Text="{x:Static strings:AppStrings.HeaderChooseOption}"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Start" />

            <!-- MODE TOGGLE (replaces radio buttons, whose unselected circle was nearly invisible in light mode) -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                    Padding="3">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                    <Border x:Name="Find_Station"
                            Grid.Column="0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 9"
                            Padding="8,10"
                            BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFindNearbyStationChecked}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkText}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectNearbyModeCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static strings:AppStrings.LocateNearbyStation}"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFindNearbyStationChecked}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <Border x:Name="Search_Station"
                            Grid.Column="1"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 9"
                            Padding="8,10"
                            BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsLocateStationChecked}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkText}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPickModeCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static strings:AppStrings.PickTrainStation}"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsLocateStationChecked}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>
            </Border>

            <!-- DIVIDER -->
            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                     HorizontalOptions="Fill" />

            <!-- PICKER + SEARCH -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">

                <!-- Opens the searchable station list -->
                <Border x:Name="stationPicker"
                        Grid.Column="0"
                        IsVisible="{Binding IsStationListLoaded}"
                        StrokeShape="RoundRectangle 10"
                        Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                        Padding="12,10"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChooseStationCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding StationDisplay}" FontSize="15" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="🔍" FontSize="14" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Button Text="{Binding ButtonText}"
                        Command="{Binding SearchServiceCommand}"
                        IsVisible="{Binding IsStationListLoaded}"
                        FontSize="15"
                        Padding="16,10"
                        VerticalOptions="Center"
                        Grid.Column="1"/>
            </Grid>

            <!-- OPTIONAL DESTINATION FILTER -->
            <Border IsVisible="{Binding IsStationListLoaded}"
                    StrokeShape="RoundRectangle 10"
                    Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                    Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChooseDestinationCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding DestinationDisplay}"
                       FontSize="14"
                       LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
            </Border>

            <!-- SEARCH BUTTON / LOADER / REFRESH INFO -->
            <VerticalStackLayout Spacing="8"
                                 HorizontalOptions="Center">

                <Button Text="{x:Static strings:AppStrings.SearchStations}"
                        CornerRadius="12"
                        Padding="24,12"
                        IsVisible="{Binding HideSearchButton}"
                        Command="{Binding SearchCommand}"
                        HorizontalOptions="Center" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center"/>

                <Label Text="{Binding RefreshTime}"
                       IsVisible="{Binding EnableListView}"
                       FontSize="13"
                       HorizontalOptions="Center"/>

                <Label Text="{Binding RefreshStatusText}"
                       FontSize="11"
                       Opacity="0.6"
                       HorizontalOptions="Center"
                       IsVisible="{Binding EnableListView}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Border>

</ContentView>
