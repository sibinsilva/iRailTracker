<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="iRailTracker.View.AppHomeHeader"
             xmlns:vm="clr-namespace:iRailTracker.ViewModel"
             xmlns:strings="clr-namespace:iRailTracker.Resources.Strings">

    <Border Style="{StaticResource Card}" Margin="12,12,12,8">

        <VerticalStackLayout Spacing="12">

            <Label Text="Where are you travelling from?"
                   FontSize="18"
                   FontFamily="OpenSansSemibold" />

            <!-- MODE TOGGLE (replaces radio buttons, whose unselected circle was nearly invisible in light mode) -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="4"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Border x:Name="Find_Station"
                            SemanticProperties.Description="Find stations near me"
                            Grid.Column="0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 9"
                            Padding="8,10"
                            BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFindNearbyStationChecked}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkText}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectNearbyModeCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="📍  Near me"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFindNearbyStationChecked}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <Border x:Name="Search_Station"
                            SemanticProperties.Description="Pick a station from the list"
                            Grid.Column="1"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 9"
                            Padding="8,10"
                            BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsLocateStationChecked}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkText}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPickModeCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="🚉  Pick a station"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsLocateStationChecked}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>
            </Border>

            <!-- NEAR ME: find the closest stations -->
            <Button Text="{x:Static strings:AppStrings.SearchStations}"
                    IsVisible="{Binding HideSearchButton}"
                    Command="{Binding SearchCommand}" />

            <!-- STATION + DESTINATION FIELDS (open the searchable list) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsStationListLoaded}">

                <Border x:Name="stationPicker" Style="{StaticResource FieldBox}"
                        SemanticProperties.Description="{Binding StationDisplay, StringFormat='From: {0}'}"
                        SemanticProperties.Hint="Opens the station list">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChooseStationCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Text="🚉" FontSize="16" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Text="FROM" Style="{StaticResource SectionLabel}" FontSize="10" />
                            <Label Text="{Binding StationDisplay}" FontSize="16" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="🔍" FontSize="14" VerticalOptions="Center" Opacity="0.7" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource FieldBox}"
                        SemanticProperties.Description="{Binding SelectedDestination, StringFormat='Going to: {0}'}"
                        SemanticProperties.Hint="Only list trains that stop at this station">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChooseDestinationCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Text="🎯" FontSize="16" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Text="GOING TO (OPTIONAL)" Style="{StaticResource SectionLabel}" FontSize="10" />
                            <Label Text="{Binding SelectedDestination}" FontSize="15" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center" Opacity="0.5" />
                    </Grid>
                </Border>

                <Button Text="{Binding ButtonText}"
                        Command="{Binding SearchServiceCommand}" />
            </VerticalStackLayout>

            <!-- LOADER / REFRESH INFO -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HeightRequest="28"
                               HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding EnableListView}">
                <Label Text="{Binding RefreshTime}"
                       FontSize="12"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
                <Label Grid.Column="1"
                       Text="{Binding RefreshStatusText}"
                       FontSize="11"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" />
            </Grid>

        </VerticalStackLayout>
    </Border>

</ContentView>
