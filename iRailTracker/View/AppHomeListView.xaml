<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="iRailTracker.View.AppHomeListView"
             xmlns:vm="clr-namespace:iRailTracker.ViewModel"
             xmlns:strings="clr-namespace:iRailTracker.Resources.Strings"
             xmlns:views="clr-namespace:iRailTracker.View"
             xmlns:converters="clr-namespace:iRailTracker.Converters">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:BellGlyphConverter x:Key="BellGlyphConverter" />
            <converters:BellOpacityConverter x:Key="BellOpacityConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid IsVisible="{Binding EnableListView}"
          RowDefinitions="Auto,*"
          Padding="4">

        <!-- OPTIONAL HEADER (can remove if not needed) -->
        <Label Grid.Row="0"
               Text="{x:Static strings:AppStrings.LiveTrainJourneys}"
               FontSize="Medium"
               FontAttributes="Bold"
               Margin="8,4"
               IsVisible="False" />

        <!-- CARD LIST -->
        <RefreshView Grid.Row="1"
             IsRefreshing="{Binding IsRefreshing}"
             Command="{Binding RefreshCommand}"
             IsEnabled="{Binding EnableListView}">
            <CollectionView
                        x:Name="JourneysCollectionView"
                        ItemsSource="{Binding TrainJourneys}"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill"
                        Margin="6"
                        >

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,6"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenJourneyCommand, Source={RelativeSource AncestorType={x:Type views:AppHomeListView}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="6">

                                <!-- ROUTE + TRACKING BELL -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Origin}" />
                                                <Span Text=" → " />
                                                <Span Text="{Binding Destination}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label Grid.Column="1"
                                       Text="{Binding IsTracking, Converter={StaticResource BellGlyphConverter}}"
                                       FontSize="22"
                                       Padding="8,0,0,8"
                                       VerticalOptions="Start"
                                       Opacity="{Binding IsTracking, Converter={StaticResource BellOpacityConverter}}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.ToggleTrackingCommand, Source={RelativeSource AncestorType={x:Type views:AppHomeListView}}}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>

                                <!-- CURRENT STATUS -->
                                <Label Text="{Binding CurrentStatus}"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />

                                <!-- ARRIVAL: minutes as the headline, status as a coloured badge -->
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      Margin="0,4,0,0">

                                    <Label Text="{Binding DueText}"
                                           FontSize="26"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                                    <Label Grid.Row="1"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Expected " />
                                                <Span Text="{Binding ExpectedArrival}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Border Grid.Column="1"
                                            Grid.RowSpan="2"
                                            VerticalOptions="Center"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="10,4"
                                            BackgroundColor="{Binding LateBadgeColor}">
                                        <Label Text="{Binding LateDisplay}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{Binding LateColor}" />
                                    </Border>
                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>
</ContentView>
