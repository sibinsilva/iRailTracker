<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="iRailTracker.View.AppHomeListView"
             xmlns:vm="clr-namespace:iRailTracker.ViewModel"
             xmlns:strings="clr-namespace:iRailTracker.Resources.Strings"
             xmlns:views="clr-namespace:iRailTracker.View"
             xmlns:converters="clr-namespace:iRailTracker.Converters">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:BellGlyphConverter x:Key="BellGlyphConverter" />
            <converters:BellOpacityConverter x:Key="BellOpacityConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid IsVisible="{Binding EnableListView}"
          RowDefinitions="Auto,*"
          Padding="4">

        <!-- OPTIONAL HEADER (can remove if not needed) -->
        <Label Grid.Row="0"
               Text="{x:Static strings:AppStrings.LiveTrainJourneys}"
               FontSize="Medium"
               FontAttributes="Bold"
               Margin="8,4"
               IsVisible="False" />

        <!-- CARD LIST -->
        <RefreshView Grid.Row="1"
             IsRefreshing="{Binding IsRefreshing}"
             Command="{Binding RefreshCommand}"
             IsEnabled="{Binding EnableListView}">
            <CollectionView
                        x:Name="JourneysCollectionView"
                        ItemsSource="{Binding TrainJourneys}"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill"
                        Margin="12,0"
                        >

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,6">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenJourneyCommand, Source={RelativeSource AncestorType={x:Type views:AppHomeListView}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <!-- Status colour strip | content -->
                            <Grid ColumnDefinitions="5,*" HorizontalOptions="Fill">
                                <BoxView Color="{Binding LateColor}" />

                                <Grid Grid.Column="1"
                                      Padding="14,12,6,12"
                                      HorizontalOptions="Fill"
                                      ColumnDefinitions="*,48"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="2">

                                    <!-- Destination (what people scan for) + bell -->
                                    <Label Text="{Binding Destination}"
                                           FontSize="17"
                                           FontFamily="OpenSansSemibold"
                                           LineBreakMode="TailTruncation" />

                                    <Label Grid.Column="1"
                                           Grid.RowSpan="2"
                                           Text="{Binding IsTracking, Converter={StaticResource BellGlyphConverter}}"
                                           FontFamily="MaterialIcons"
                                           FontSize="26"
                                           HorizontalOptions="End"
                                           HorizontalTextAlignment="End"
                                           Padding="8,0,6,8"
                                           VerticalOptions="Start"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           SemanticProperties.Description="Track this journey"
                                           Opacity="{Binding IsTracking, Converter={StaticResource BellOpacityConverter}}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.ToggleTrackingCommand, Source={RelativeSource AncestorType={x:Type views:AppHomeListView}}}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <HorizontalStackLayout Grid.Row="1" Spacing="6">
                                        <Border IsVisible="{Binding IsDart}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="6,1"
                                                VerticalOptions="Center"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource ChipBackgroundLight}, Dark={StaticResource ChipBackgroundDark}}">
                                            <Label Text="DART" FontSize="10" FontFamily="OpenSansSemibold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        </Border>
                                        <Label FontSize="12"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="from " />
                                                    <Span Text="{Binding Origin}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding TrainCode}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <!-- Minutes as the headline, departure time beside it, status badge on the right -->
                                    <HorizontalStackLayout Grid.Row="2" Spacing="10" Margin="0,8,0,0" VerticalOptions="End">
                                        <Label Text="{Binding DueText}"
                                               FontSize="26"
                                               FontFamily="OpenSansSemibold"
                                               VerticalOptions="End"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Label FontSize="13"
                                               VerticalOptions="End"
                                               Margin="0,0,0,4"
                                               TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ExpectedTimeLabel}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding ExpectedArrival}" FontFamily="OpenSansSemibold" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <Border Grid.Row="2"
                                            Grid.Column="1"
                                            VerticalOptions="End"
                                            Margin="0,0,4,4"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="10,4"
                                            BackgroundColor="{Binding LateBadgeColor}">
                                        <Label Text="{Binding LateDisplay}"
                                               FontSize="12"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{Binding LateColor}" />
                                    </Border>

                                    <!-- Where the train is now -->
                                    <Label Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="📍 " />
                                                <Span Text="{Binding CurrentStatus}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>
</ContentView>
