<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="iRailTracker.View.AppSettings"
             xmlns:converters="clr-namespace:iRailTracker.Converters"
             xmlns:vm="clr-namespace:iRailTracker.ViewModel"
             Title="Settings">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />

            <Style x:Key="CardTitle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
            </Style>
            <Style x:Key="CardHint" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">

            <!-- AUTO REFRESH -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="🔄  Auto refresh" Style="{StaticResource CardTitle}" />
                            <Label Text="Keep the departure board up to date" Style="{StaticResource CardHint}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsAutoRefreshEnabled}"
                                OnColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                SemanticProperties.Description="Auto refresh"
                                VerticalOptions="Center" />
                    </Grid>

                    <Border Style="{StaticResource FieldBox}" Padding="10,2" IsEnabled="{Binding IsAutoRefreshEnabled}">
                        <Picker Title="Refresh every"
                                ItemsSource="{Binding RefreshIntervals}"
                                ItemDisplayBinding="{Binding Display}"
                                SelectedItem="{Binding SelectedRefreshInterval}"
                                IsEnabled="{Binding IsAutoRefreshEnabled}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- FAVOURITE STATIONS -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="★  Favourite stations" Style="{StaticResource CardTitle}" />
                    <Label Text="Quick-access chips on Home. The first one opens on startup and is shown in the widget."
                           Style="{StaticResource CardHint}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border Style="{StaticResource FieldBox}" Padding="10,2">
                            <Picker Title="Add a station"
                                    ItemsSource="{Binding StationNames}"
                                    SelectedIndex="{Binding SelectedStationToAddIndex, Mode=TwoWay}"
                                    FontSize="15" />
                        </Border>
                        <Button Grid.Column="1"
                                Text="Add"
                                Command="{Binding AddFavouriteCommand}"
                                VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding FavouriteStations}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}" Padding="14,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding .}"
                                               FontSize="15"
                                               FontFamily="OpenSansSemibold"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Label Grid.Column="1"
                                               Text="✕"
                                               FontSize="16"
                                               Padding="12,6,4,6"
                                               VerticalOptions="Center"
                                               SemanticProperties.Description="Remove favourite"
                                               TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppSettingsViewModel}}, Path=RemoveFavouriteCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- DELAY NOTIFICATIONS -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="🔔  Delay alerts" Style="{StaticResource CardTitle}" />
                            <Label Text="Alert me when a journey I'm tracking runs late"
                                   Style="{StaticResource CardHint}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsDelayNotificationsEnabled}"
                                OnColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                SemanticProperties.Description="Delay alerts"
                                VerticalOptions="Center" />
                    </Grid>

                    <Border Style="{StaticResource FieldBox}" Padding="10,2">
                        <Picker Title="Alert when late by"
                                ItemsSource="{Binding DelayThresholds}"
                                ItemDisplayBinding="{Binding Display}"
                                SelectedItem="{Binding SelectedDelayThreshold}"
                                IsEnabled="{Binding IsDelayNotificationsEnabled}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- COMMUTE ALERTS -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="🧳  Commute alerts" Style="{StaticResource CardTitle}" />
                            <Label Text="Get a notification when a train on your usual journey runs late, without tracking it."
                                   Style="{StaticResource CardHint}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsCommuteEnabled}"
                                OnColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                SemanticProperties.Description="Commute alerts"
                                VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border Style="{StaticResource FieldBox}" SemanticProperties.Description="{Binding CommuteFromDisplay, StringFormat='Commute from {0}'}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChooseCommuteFromCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="FROM" Style="{StaticResource SectionLabel}" FontSize="10" />
                                <Label Text="{Binding CommuteFromDisplay}" FontSize="14" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FieldBox}" SemanticProperties.Description="{Binding CommuteToDisplay, StringFormat='Commute to {0}'}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChooseCommuteToCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="TO" Style="{StaticResource SectionLabel}" FontSize="10" />
                                <Label Text="{Binding CommuteToDisplay}" FontSize="14" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                        <Label Text="Between" VerticalOptions="Center" Style="{StaticResource CardHint}" />
                        <TimePicker Grid.Column="1" Time="{Binding CommuteStart}" Format="HH:mm" SemanticProperties.Description="Earliest departure" />
                        <Label Grid.Column="2" Text="and" VerticalOptions="Center" Style="{StaticResource CardHint}" />
                        <TimePicker Grid.Column="3" Time="{Binding CommuteEnd}" Format="HH:mm" SemanticProperties.Description="Latest departure" />
                    </Grid>

                    <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding WeekdayChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="38" HeightRequest="38"
                                        StrokeShape="RoundRectangle 19"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                                        BackgroundColor="Transparent"
                                        SemanticProperties.Description="{Binding Day}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkText}}" />
                                            <Setter Property="Stroke" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppSettingsViewModel}}, Path=ToggleWeekdayCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <Border Style="{StaticResource FieldBox}" Padding="10,2">
                        <Picker Title="Alert when late by"
                                ItemsSource="{Binding DelayThresholds}"
                                ItemDisplayBinding="{Binding Display}"
                                SelectedItem="{Binding SelectedCommuteThreshold}" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding CommuteStatus}" Style="{StaticResource CardHint}" FontSize="12" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Check now" Padding="14,6"
                                Command="{Binding CheckCommuteNowCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- APP UPDATES (sideloaded APK only) -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsSelfUpdateSupported}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="⬆️  App updates" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsUpdateNotificationsEnabled}"
                                SemanticProperties.Description="Notify me about new versions" />
                    </Grid>
                    <Label Text="Get a notification when a new version is released." Style="{StaticResource CardHint}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding AppVersionDisplay}" Style="{StaticResource CardHint}" FontSize="12" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Check for updates" Padding="14,6"
                                Command="{Binding CheckForUpdatesCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- DIAGNOSTICS -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🩺  Diagnostics" Style="{StaticResource CardTitle}" />
                    <Label Text="{Binding CrashLogStatus}" Style="{StaticResource CardHint}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding HasCrashLog}">
                        <Button Text="Share crash log" Command="{Binding ShareCrashLogCommand}" />
                        <Button Grid.Column="1" Text="Clear"
                                Command="{Binding ClearCrashLogCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
