<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="iRailTracker.View.StationSearchPage">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Clicked="OnCancelClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="12,8">
        <SearchBar x:Name="StationSearchBar"
                   Placeholder="Search stations"
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                   TextChanged="OnSearchTextChanged" />

        <CollectionView x:Name="StationList"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        SelectionMode="Single"
                        SelectionChanged="OnStationSelected">
            <CollectionView.EmptyView>
                <Label Text="No matching stations"
                       Margin="0,24"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Style="{StaticResource Card}" Padding="14,14" Margin="0,4">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="🚉" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding .}" FontSize="16" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
