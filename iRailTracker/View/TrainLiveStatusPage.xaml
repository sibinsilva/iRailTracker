<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="iRailTracker.View.TrainLiveStatusPage"
             Title="Live Status">

    <ContentPage.Resources>
        <Style x:Key="MapButton" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Setter Property="Shadow">
                <Shadow Brush="Black" Opacity="0.2" Radius="8" Offset="0,2" />
            </Setter>
        </Style>
    </ContentPage.Resources>

    <!-- Full-screen map with the route card, legend and buttons floating on top -->
    <Grid>
        <mapsui:MapControl x:Name="TrainMapControl" />

        <!-- ROUTE CARD -->
        <Border Style="{StaticResource Card}"
                VerticalOptions="Start"
                Margin="12"
                Padding="16,14">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                <Label FontSize="17" FontFamily="OpenSansSemibold" LineBreakMode="WordWrap">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Origin}" />
                            <Span Text="  →  " TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Span Text="{Binding Destination}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Border Grid.Column="1"
                        VerticalOptions="Start"
                        Margin="8,0,0,0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="10,4"
                        BackgroundColor="{Binding LateBadgeColor}">
                    <Label Text="{Binding LateDisplay}" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{Binding LateColor}" />
                </Border>

                <Label Grid.Row="1" Grid.ColumnSpan="2" FontSize="13" LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding ExpectedTimeLabel}" />
                            <Span Text=" " />
                            <Span Text="{Binding ExpectedArrival}" FontFamily="OpenSansSemibold" />
                            <Span Text="  ·  " />
                            <Span Text="{Binding TrainCode}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label x:Name="LiveStatusLabel" Grid.Row="2" Grid.ColumnSpan="2"
                       IsVisible="False" FontSize="13" FontFamily="OpenSansSemibold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </Grid>
        </Border>

        <!-- TAPPED PIN DETAILS -->
        <Border x:Name="PinInfoOverlay"
                Style="{StaticResource Card}"
                IsVisible="False"
                VerticalOptions="End"
                HorizontalOptions="Center"
                Margin="12,0,12,72"
                Padding="16,10">
            <VerticalStackLayout Spacing="2">
                <Label x:Name="PinStationLabel" FontFamily="OpenSansSemibold" FontSize="15" />
                <Label x:Name="PinArrivalLabel" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource SubtleTextLight}, Dark={StaticResource SubtleTextDark}}" />
            </VerticalStackLayout>
        </Border>

        <!-- LEGEND -->
        <Border VerticalOptions="End"
                HorizontalOptions="Start"
                Margin="12,0,0,16"
                Padding="12,8"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#EBFFFFFF, Dark=#EB171C1C}">
            <HorizontalStackLayout Spacing="10">
                <Label FontSize="11"><Label.FormattedText><FormattedString>
                    <Span Text="● " TextColor="#FFA500" FontSize="14" /><Span Text="Train" />
                </FormattedString></Label.FormattedText></Label>
                <Label FontSize="11"><Label.FormattedText><FormattedString>
                    <Span Text="● " TextColor="#228B22" FontSize="14" /><Span Text="Start" />
                </FormattedString></Label.FormattedText></Label>
                <Label FontSize="11"><Label.FormattedText><FormattedString>
                    <Span Text="● " TextColor="#4169E1" FontSize="14" /><Span Text="Stops" />
                </FormattedString></Label.FormattedText></Label>
                <Label FontSize="11"><Label.FormattedText><FormattedString>
                    <Span Text="● " TextColor="#DC143C" FontSize="14" /><Span Text="End" />
                </FormattedString></Label.FormattedText></Label>
            </HorizontalStackLayout>
        </Border>

        <!-- MAP BUTTONS -->
        <VerticalStackLayout VerticalOptions="End"
                             HorizontalOptions="End"
                             Margin="0,0,12,16"
                             Spacing="10">
            <Button Text="🚆  Follow train" Style="{StaticResource MapButton}" Clicked="OnCenterOnTrainClicked" />
            <Button Text="⤢  Whole route" Style="{StaticResource MapButton}" Clicked="OnShowRouteClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
