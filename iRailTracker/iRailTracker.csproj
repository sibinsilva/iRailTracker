<Project Sdk="Microsoft.NET.Sdk">

  <!-- =============================== -->
  <!-- 🔷 VERSIONING -->
  <!-- =============================== -->
  <PropertyGroup>
    <!-- Release version, used when no vX.Y.Z tag exists (bump when releasing) -->
    <VersionMajor>2</VersionMajor>
    <VersionMinor>62</VersionMinor>
    <VersionPatch>2</VersionPatch>

    <!-- Store-safe build number (must always increase): computed in ComputeDisplayVersion
         below from the commit count. This is only the fallback. -->
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Release safety flag -->
    <ConfirmMajorBump>false</ConfirmMajorBump>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <!-- Mac Catalyst workloads are unavailable on Linux (e.g. CI runners) -->
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
    <RootNamespace>iRailTracker</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>iRailTracker</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.app.irailtracker</ApplicationId>

    <!-- ⚠️ Display version composed later -->

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- =============================== -->
  <!-- 🔷 VERSION FROM TAG, BUILD NUMBER FROM GIT -->
  <!-- =============================== -->
  <!-- The version (2.61.0) comes from the latest vX.Y.Z tag, or the VersionMajor/Minor/Patch
       properties above when there is none, so it only changes on purpose. The Android
       versionCode still grows with every commit so each build installs over the last. -->
  <Target Name="ComputeGitHeight" BeforeTargets="PrepareForBuild">
    <Exec Command="git rev-list --count HEAD"
        ConsoleToMSBuild="true"
        IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitHeightRaw" />
    </Exec>

    <PropertyGroup>
      <GitHeight Condition="'$(GitHeightRaw)'!=''">$([System.String]::Copy('$(GitHeightRaw)').Trim())</GitHeight>
      <GitHeight Condition="'$(GitHeight)'==''">0</GitHeight>
    </PropertyGroup>
  </Target>

  <Target Name="ComputeVersionFromTag" BeforeTargets="PrepareForBuild" DependsOnTargets="ComputeGitHeight">
    <Exec Command="git describe --tags --abbrev=0 --match v* 2>nul"
        Condition="$([MSBuild]::IsOSPlatform('windows'))"
        ConsoleToMSBuild="true"
        IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitTagRaw" />
    </Exec>
    <Exec Command="git describe --tags --abbrev=0 --match 'v*' 2>/dev/null"
        Condition="!$([MSBuild]::IsOSPlatform('windows'))"
        ConsoleToMSBuild="true"
        IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitTagRaw" />
    </Exec>

    <PropertyGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(GitTagRaw)', '^v\d+\.\d+\.\d+$'))">
      <VersionMajor>$([System.Text.RegularExpressions.Regex]::Match('$(GitTagRaw)', '(\d+)\.(\d+)\.(\d+)').Groups[1].Value)</VersionMajor>
      <VersionMinor>$([System.Text.RegularExpressions.Regex]::Match('$(GitTagRaw)', '(\d+)\.(\d+)\.(\d+)').Groups[2].Value)</VersionMinor>
      <VersionPatch>$([System.Text.RegularExpressions.Regex]::Match('$(GitTagRaw)', '(\d+)\.(\d+)\.(\d+)').Groups[3].Value)</VersionPatch>
    </PropertyGroup>
  </Target>

  <!-- =============================== -->
  <!-- 🔷 DISPLAY VERSION -->
  <!-- =============================== -->
  <Target Name="ComputeDisplayVersion" BeforeTargets="_GetAndroidPackageName;PrepareForBuild" DependsOnTargets="ComputeVersionFromTag">
    <PropertyGroup>
      <ApplicationDisplayVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch)</ApplicationDisplayVersion>
      <!-- 2100000 + commit count: always above the old scheme's codes (2.60.0 was 2060000) -->
      <ApplicationVersion>$([MSBuild]::Add(2100000, $(GitHeight)))</ApplicationVersion>
    </PropertyGroup>
    <Message Importance="high" Text="📦 ApplicationDisplayVersion=$(ApplicationDisplayVersion) Build=$(ApplicationVersion)" />
  </Target>

  <!-- =============================== -->
  <!-- 🔷 RELEASE GUARD -->
  <!-- =============================== -->
  <!-- Blocks CLI release builds unless -p:ConfirmMajorBump=true is passed.
       Visual Studio (Archive, etc.) is always allowed through. -->
  <Target Name="GuardRelease"
      BeforeTargets="PrepareForBuild"
      DependsOnTargets="ComputeDisplayVersion"
      Condition="'$(Configuration)'=='Release' AND '$(BuildingInsideVisualStudio)'!='true'">

    <Message Importance="high"
         Text="🚀 Release build detected. Version=$(ApplicationDisplayVersion)" />

    <Error Condition="'$(ConfirmMajorBump)'!='true'"
         Text="❌ Release blocked. Verify VersionMajor and build with -p:ConfirmMajorBump=true" />
  </Target>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidKeyStore>False</AndroidKeyStore>
    <!-- Ship only 64-bit ARM native code in release APKs (all current phones); roughly halves the size -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <!-- The Play Store bundle (CI: -p:BuildPlayBundle=true) also carries 32-bit ARM. Set here rather than
         on the command line, where the list leaked into the net10.0 target and failed (NETSDK1083). -->
    <RuntimeIdentifiers Condition="'$(BuildPlayBundle)'=='true'">android-arm64;android-arm</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|AnyCPU'">
    <ApplicationId>com.app.irailtracker</ApplicationId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|AnyCPU'">
    <ApplicationId>com.app.irailtracker</ApplicationId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
    <AndroidKeyStore>False</AndroidKeyStore>
  </PropertyGroup>

  <ItemGroup>
		<!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#0F766E" />

		<!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#042F2E" BaseSize="128,128" />

		<!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- WorkManager: periodic background check for commute delay alerts -->
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the unit tests drive internal view model methods directly -->
    <InternalsVisibleTo Include="iRailTracker.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Mapsui.Maui" Version="5.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.41" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.3" />
    <PackageReference Include="Plugin.LocalNotification" Version="14.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings\AppMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AppMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Strings\AppStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AppStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings\AppMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AppMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings\AppStrings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AppStrings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="View\AboutPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="View\AppHome.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="View\AppHomeHeader.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="View\AppHomeListView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="View\AppSettings.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="View\ChangelogPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="View\StartPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="View\TrainLiveStatusPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

</Project>
